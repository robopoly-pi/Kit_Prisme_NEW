	(gr_text "6mm width, 1.6mm thickness, lever lenght : 22mm \nThe IR sensor should break with force between 10 N and 70 N (1-7Kg)"
		(at 168.6 221.3 0)
		(layer "F.Fab")
		(uuid "4b545e6f-c2b2-4e11-a567-29abe0cc0ea8")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "Radius and groove are based on a typical PCB drill (2mm diameter, 1mm radius"
		(at 206.8 204.08 0)
		(layer "F.Fab")
		(uuid "96a63b3a-f85b-49c1-b456-7832486ee2c2")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "Could the PCB have been smaller ? sure\nwould it be as easy to solder ? not so sure"
		(at 114.1 217.4 0)
		(layer "F.Fab")
		(uuid "b9fc9cd1-55a7-4fbd-a68b-a13228198462")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "each IR sensor can be broken and reconnected using four cable at a different location"
		(at 137.5 77 0)
		(layer "User.1")
		(uuid "42f22e59-e261-435f-ac64-2e0fb09d6fd8")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "this allow you to change the mechanical layout or use other (analog) sensors if you want to repurpose the kit"
		(at 137.2 79.1 0)
		(layer "User.1")
		(uuid "44662011-8646-439b-a0cd-5b7384a14bcc")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "theses are made to be broken off and soldered unsing 90° pin header bellow the PCB"
		(at 181.2 83.3 0)
		(layer "User.1")
		(uuid "79e2eecd-31cb-4709-9133-5e812f6d4e4f")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
